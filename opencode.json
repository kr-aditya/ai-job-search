{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.gnupg/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".claude/settings.json": "ask",
      ".claude/settings.local.json": "ask",
      ".claude/skills/*/SKILL.md": "ask",
      ".claude/commands/*.md": "ask",
      ".claude/agents/**": "ask",
      ".github/**": "ask",
      "tools/security_guards.py": "ask",
      "tools/**": "ask",
      ".agents/**": "ask",
      ".opencode/**": "ask",
      "salary_lookup.py": "ask"
    },
    "bash": {
      "*": "ask",
      "bun run .agents/skills/*/cli/src/cli.ts*": "allow",
      "python salary_lookup.py*": "allow",
      "python3 salary_lookup.py*": "allow",
      "python tools/rank_state.py*": "allow",
      "python3 tools/rank_state.py*": "allow",
      "python tools/job_key.py*": "allow",
      "python3 tools/job_key.py*": "allow",
      "python tools/scrape_state.py*": "allow",
      "python3 tools/scrape_state.py*": "allow",
      "python tools/verify_pdf.py*": "allow",
      "python3 tools/verify_pdf.py*": "allow",
      "python tools/verify_layout.py*": "allow",
      "python3 tools/verify_layout.py*": "allow",
      "python tools/robots_check.py*": "allow",
      "python3 tools/robots_check.py*": "allow",
      "python tools/fetch_page.py*": "allow",
      "python3 tools/fetch_page.py*": "allow",
      "python tools/posting_guard.py*": "allow",
      "python3 tools/posting_guard.py*": "allow",
      "git push*": "ask",
      "curl -d*": "deny",
      "curl --data*": "deny",
      "curl -F*": "deny",
      "curl --form*": "deny",
      "curl -T*": "deny",
      "curl --upload-file*": "deny",
      "curl -X POST*": "deny",
      "curl -X PUT*": "deny",
      "curl -XPOST*": "deny",
      "curl --request POST*": "deny",
      "wget --post-data*": "deny",
      "wget --post-file*": "deny",
      "wget --method=POST*": "deny",
      "scp*": "deny",
      "sftp*": "deny",
      "ssh*": "deny",
      "nc*": "deny",
      "ncat*": "deny",
      "netcat*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask"
  }
}
